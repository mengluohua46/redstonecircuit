### Minecraft Modding ###
run/
!**/src/**/run/
**/src/generated/**/.cache/
repo/
!**/src/**/repo/

# gradle run logs written by the dev shell
.gradle-*.log

# Third-party *nested* jars the optional physics compat compiles against (Sable's companion jar and
# Create's ponder jar). They are unpacked at build time from the installed mods
# (physicsModsDir in neoforge/gradle.properties) into build/, so they are never committed;
# neoforge/libs/README.md says where they come from.
neoforge/libs/*.jar
libs/*.jar

# dev-run client/server logs
logs/

# release jars (built from build/libs)
dist/

# development records (诊断日志、上架材料、交付说明…): they live in 红石电路 outside this repository,
# and are ignored here so a stray copy can never be committed by accident.
交付说明-*.md
上架材料-*.md
开发记录/
COMPAT-*.md
PORT-TODO.md

# scratch file a build script writes its commit message into
build_msg.tmp
build/_msg.tmp

# dev GameTest run directory (a world, an eula and per-run configs are not source)
run-gametest/
**/run-gametest/
